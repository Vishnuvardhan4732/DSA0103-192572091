#include <iomanip>
#include <iostream>
#include <string>
using namespace std;

class Cart {
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;

public:
    Cart& add(const string& item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            ++n;
        }

        return *this;
    }

    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;

        for (int i = 0; i < n; i++)
            t += prices[i];

        return t * (100 - discount) / 100;
    }
};

int main() {
    Cart direct;

    direct.add("Rice", 60);

    Cart* pointer = &direct;
    pointer->add("Dal", 120);

    Cart& reference = direct;
    reference.add("Oil", 180);

    Cart* dynamicCart = new Cart;
    dynamicCart->add("Milk", 50);

    cout << fixed << setprecision(2);
    cout << direct.total() << '\n';
    cout << dynamicCart->total() << '\n';

    delete dynamicCart;
    return 0;
}


