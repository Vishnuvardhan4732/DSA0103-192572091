#include <iostream>
using namespace std;

class Cart {
    double amount;

public:
    explicit Cart(double a) : amount(a) {}

    double total() const {
        return amount;
    }
};

int main() {
    Cart c1(250), c2(480), c3(325);

    Cart* carts[3] = { &c1, &c2, &c3 };

    int best = 0;

    for (int i = 1; i < 3; i++) {
        if (carts[i]->total() > carts[best]->total())
            best = i;
    }

    cout << "Highest cart total: "
         << carts[best]->total()
         << " at index " << best << '\n';

    return 0;
}


