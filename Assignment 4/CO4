#include <iostream>
#include <iomanip>
#include <memory>
#include <string>
#include <vector>
using namespace std;

class Vehicle {
protected:
    string registration;
    double dailyRate;
    bool rented = false;

public:
    Vehicle(string reg, double rate)
        : registration(reg), dailyRate(rate) {}

    virtual double charge(int days) const = 0;

    virtual void display() const {
        cout << registration << " rate/day=" << dailyRate;
    }

    bool rent() {
        if (rented)
            return false;

        rented = true;
        return true;
    }

    double returnVehicle(int days, int lateDays,
                         double lateFeePerDay) {
        if (!rented || days < 1 || lateDays < 0)
            return -1.0;

        rented = false;
        return charge(days) + lateDays * lateFeePerDay;
    }

    virtual ~Vehicle() = default;
};

class MotorVehicle : public Vehicle {
protected:
    double energyLevel;
    string serviceDue;

public:
    MotorVehicle(string reg, double rate,
                 double energy, string due)
        : Vehicle(reg, rate),
          energyLevel(energy), serviceDue(due) {}

    void display() const override {
        Vehicle::display();
        cout << " energy=" << energyLevel
             << " serviceDue=" << serviceDue;
    }
};

class Bicycle : public Vehicle {
public:
    Bicycle(string reg, double rate)
        : Vehicle(reg, rate) {}

    double charge(int days) const override {
        return dailyRate * days;
    }
};

class TwoWheeler : public MotorVehicle {
public:
    TwoWheeler(string reg, double rate,
               double fuel, string due)
        : MotorVehicle(reg, rate, fuel, due) {}

    double charge(int days) const override {
        return dailyRate * days + 20.0;
    }
};

class Car : public MotorVehicle {
    int seats;

public:
    Car(string reg, double rate, double fuel,
        string due, int s)
        : MotorVehicle(reg, rate, fuel, due), seats(s) {}

    double charge(int days) const override {
        return dailyRate * days + seats * 10.0;
    }
};

class ElectricVehicle : public MotorVehicle {
protected:
    double batteryCapacity;
    double kWhUsed;

public:
    ElectricVehicle(string reg, double rate, double level,
                    string due, double capacity, double used)
        : MotorVehicle(reg, rate, level, due),
          batteryCapacity(capacity), kWhUsed(used) {}

    void display() const override {
        MotorVehicle::display();
        cout << " batteryKWh=" << batteryCapacity;
    }
};

class ElectricCar : public ElectricVehicle {
    int seats;
    double pricePerKWh;

public:
    ElectricCar(string reg, double rate, double level,
                string due, double capacity, double used,
                int s, double price)
        : ElectricVehicle(reg, rate, level, due, capacity, used),
          seats(s), pricePerKWh(price) {}

    double charge(int days) const override {
        return dailyRate * days + kWhUsed * pricePerKWh
               + seats * 10.0;
    }
};

class ElectricBus : public ElectricVehicle {
    int seats;
    double pricePerKWh;

public:
    ElectricBus(string reg, double rate, double level,
                string due, double capacity, double used,
                int s, double price)
        : ElectricVehicle(reg, rate, level, due, capacity, used),
          seats(s), pricePerKWh(price) {}

    double charge(int days) const override {
        return dailyRate * days + kWhUsed * pricePerKWh
               + seats * 5.0;
    }
};

int main() {
    vector<unique_ptr<Vehicle>> fleet;

    fleet.push_back(make_unique<Bicycle>("BIKE01", 100));

    fleet.push_back(make_unique<TwoWheeler>(
        "TW02", 250, 80, "2026-12-01"));

    fleet.push_back(make_unique<Car>(
        "CAR03", 1200, 70, "2026-12-10", 5));

    fleet.push_back(make_unique<ElectricCar>(
        "EV04", 1500, 90, "2026-12-15", 60, 18, 5, 8));

    fleet.push_back(make_unique<ElectricBus>(
        "EB05", 3000, 85, "2026-12-20", 180, 50, 30, 7));

    cout << fixed << setprecision(2);

    for (const auto& v : fleet) {
        v->display();
        cout << '\n';

        if (v->rent()) {
            double bill = v->returnVehicle(2, 1, 100);
            cout << "Rental bill: " << bill << '\n';
        }
    }

    return 0;
}

