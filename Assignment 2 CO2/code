#include <chrono>
#include <iostream>

#if defined(__GNUC__) || defined(__clang__)
__attribute__((noinline))
#endif
int minutesBetweenNoInline(int h1, int m1, int h2, int m2) {
    int first = h1 * 60 + m1;
    int second = h2 * 60 + m2;
    int difference = first - second;
    return difference < 0 ? -difference : difference;
}

inline int minutesBetweenInline(int h1, int m1, int h2, int m2) {
    int first = h1 * 60 + m1;
    int second = h2 * 60 + m2;
    int difference = first - second;
    return difference < 0 ? -difference : difference;
}

volatile long long resultSink = 0;

long long benchNoInline() {
    long long total = 0;
    const int N = 10000000;
    auto start = std::chrono::steady_clock::now();
    for (int i = 0; i < N; ++i) {
        total += minutesBetweenNoInline(i % 24, (i * 7) % 60,
                                        (i * 13) % 24, (i * 17) % 60);
    }
    auto end = std::chrono::steady_clock::now();
    resultSink = total;
    return std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count();
}

long long benchInline() {
    long long total = 0;
    const int N = 10000000;
    auto start = std::chrono::steady_clock::now();
    for (int i = 0; i < N; ++i) {
        total += minutesBetweenInline(i % 24, (i * 7) % 60,
                                      (i * 13) % 24, (i * 17) % 60);
    }
    auto end = std::chrono::steady_clock::now();
    resultSink = total;
    return std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count();
}

int main() {
    std::cout << "Calls per test: 10000000\n";
    std::cout << "No-inline time (ms): " << benchNoInline() << '\n';
    std::cout << "Inline time (ms): " << benchInline() << '\n';
    std::cout << "Keep sink: " << resultSink << '\n';
}


