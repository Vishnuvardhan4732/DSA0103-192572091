#include <iostream>

int& highestMark(int marks[], int n) {
    int best = 0;
    for (int i = 1; i < n; ++i) {
        if (marks[i] > marks[best]) {
            best = i;
        }
    }
    return marks[best];
}

// Demonstration only: do not call this function. The reference dangles after return.
int& badReference() {
    int local = 10;
    return local; // compiler warning; using the returned reference is undefined behaviour
}

int highestIndex(const int marks[], int n) {
    int best = 0;
    for (int i = 1; i < n; ++i) {
        if (marks[i] > marks[best]) {
            best = i;
        }
    }
    return best;
}

int* highestPointer(int marks[], int n) {
    if (n <= 0) return nullptr;
    int best = 0;
    for (int i = 1; i < n; ++i) {
        if (marks[i] > marks[best]) {
            best = i;
        }
    }
    return &marks[best];
}

int main() {
    int marks[] = {76, 91, 84, 88, 91};
    int n = static_cast<int>(sizeof(marks) / sizeof(marks[0]));

    std::cout << "Highest before moderation: " << highestMark(marks, n) << '\n';
    highestMark(marks, n) += 2;
    std::cout << "Highest after moderation: " << highestMark(marks, n) << '\n';

    std::cout << "Marks: ";
    for (int i = 0; i < n; ++i) std::cout << marks[i] << ' ';
    std::cout << '\n';

    std::cout << "Highest index (0-based): " << highestIndex(marks, n) << '\n';
    int* p = highestPointer(marks, n);
    if (p != nullptr) std::cout << "Highest through pointer: " << *p << '\n';
    return 0;
}


