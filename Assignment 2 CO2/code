#include <chrono>
#include <iostream>

template <int CAPACITY>
class ShiftHistory {
    int values[CAPACITY]{};
    int count = 0;
public:
    void add(int value) {
        if (count < CAPACITY) {
            values[count++] = value;
        } else {
            for (int i = 1; i < CAPACITY; ++i) values[i - 1] = values[i];
            values[CAPACITY - 1] = value;
        }
    }
    int at(int i) const { return values[i]; }
    int size() const { return count; }
};

template <int CAPACITY>
class CircularHistory {
    int values[CAPACITY]{};
    int count = 0;
    int next = 0;
public:
    void add(int value) {
        values[next] = value;
        next = (next + 1) % CAPACITY;
        if (count < CAPACITY) ++count;
    }
    int size() const { return count; }
    int at(int i) const {
        int start = count == CAPACITY ? next : 0;
        return values[(start + i) % CAPACITY];
    }
};

volatile long long checksumSink = 0;

template <int CAPACITY>
void testCapacity(long long operations) {
    ShiftHistory<CAPACITY> shifted;
    CircularHistory<CAPACITY> circular;

    auto startShift = std::chrono::steady_clock::now();
    for (long long i = 0; i < operations; ++i) shifted.add(static_cast<int>(i % 100000));
    auto endShift = std::chrono::steady_clock::now();

    auto startCircular = std::chrono::steady_clock::now();
    for (long long i = 0; i < operations; ++i) circular.add(static_cast<int>(i % 100000));
    auto endCircular = std::chrono::steady_clock::now();

    bool same = shifted.size() == circular.size();
    long long checksum = 0;
    for (int i = 0; i < shifted.size(); ++i) {
        if (shifted.at(i) != circular.at(i)) same = false;
        checksum += shifted.at(i) + circular.at(i);
    }
    checksumSink = checksum;

    auto shiftMs = std::chrono::duration_cast<std::chrono::milliseconds>(endShift - startShift).count();
    auto ringMs = std::chrono::duration_cast<std::chrono::milliseconds>(endCircular - startCircular).count();
    std::cout << "Capacity " << CAPACITY << ", operations " << operations << '\n';
    std::cout << "Shifting time (ms): " << shiftMs << '\n';
    std::cout << "Circular time (ms): " << ringMs << '\n';
    std::cout << "Last values match: " << (same ? "yes" : "no") << '\n';
    std::cout << "Final values: ";
    for (int i = 0; i < shifted.size(); ++i) std::cout << shifted.at(i) << (i + 1 == shifted.size() ? '\n' : ' ');
}

int main() {
    const long long operations = 1000000;
    testCapacity<10>(operations);
    testCapacity<50>(operations);
}
