#include <iostream>
using namespace std;

enum class Unit {
    Grams,
    Kilograms
};

struct Parcel {
    double weight;
    Unit unit;
    bool express = false;
    bool insured = false;
};

double chargeParcel(const Parcel& p) {
    double total;

    if (p.unit == Unit::Grams)
        total = p.weight * 0.02;
    else
        total = p.weight * 100;

    if (p.express)
        total += 30;

    if (p.insured)
        total += 10;

    return total;
}

