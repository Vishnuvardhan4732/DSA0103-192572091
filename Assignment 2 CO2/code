#include <iostream>
#include <string>

class SavingsAccount {
private:
    std::string accountNumber;
    double balance;
    double transactions[10];
    int count;

    void record(double amount) {
        if (count < 10) {
            transactions[count] = amount;
            ++count;
        } else {
            // Shift left to discard the oldest transaction.
            for (int i = 1; i < 10; ++i) {
                transactions[i - 1] = transactions[i];
            }
            transactions[9] = amount;
        }
    }

public:
    SavingsAccount(const std::string& number, double openingBalance)
        : accountNumber(number), balance(openingBalance), count(0) {}

    void deposit(double amount) {
        if (amount <= 0) return;
        balance += amount;
        record(amount);
    }

    bool withdraw(double amount); // defined outside the class

    void miniStatement() const {
        std::cout << "Account: " << accountNumber << '\n';
        std::cout << "Balance: " << balance << '\n';
        std::cout << "Recent transactions (oldest to newest):\n";
        for (int i = 0; i < count; ++i) {
            std::cout << transactions[i] << '\n';
        }
    }
};

bool SavingsAccount::withdraw(double amount) {
    if (amount <= 0 || balance < amount) return false;
    balance -= amount;
    record(-amount);
    return true;
}

int main() {
    SavingsAccount account("SA1001", 1000);
    for (int i = 1; i <= 12; ++i) {
        account.deposit(i * 10);
    }
    account.withdraw(50);
    account.miniStatement();
    return 0;
}


