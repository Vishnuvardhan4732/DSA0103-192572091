#include <iostream>
#include <string>

class SavingsAccount {
private:
    static constexpr int CAPACITY = 10;
    std::string accountNumber;
    double balance;
    double transactions[CAPACITY];
    int count;
    int next;

    void record(double amount) {
        transactions[next] = amount;
        next = (next + 1) % CAPACITY;
        if (count < CAPACITY) ++count;
    }

public:
    SavingsAccount(const std::string& number, double openingBalance)
        : accountNumber(number), balance(openingBalance), count(0), next(0) {}

    void deposit(double amount) {
        if (amount <= 0) return;
        balance += amount;
        record(amount);
    }

    bool withdraw(double amount);

    void miniStatement() const {
        std::cout << "Account: " << accountNumber << '\n';
        std::cout << "Balance: " << balance << '\n';
        std::cout << "Recent transactions (oldest to newest):\n";
        int start = (count == CAPACITY) ? next : 0;
        for (int i = 0; i < count; ++i) {
            std::cout << transactions[(start + i) % CAPACITY] << '\n';
        }
    }
};

bool SavingsAccount::withdraw(double amount) {
    if (amount <= 0 || balance < amount) return false;
    balance -= amount;
    record(-amount);
    return true;
}

int main() {
    SavingsAccount account("SA1001", 1000);
    for (int i = 1; i <= 12; ++i) account.deposit(i * 10);
    account.withdraw(50);
    account.miniStatement();
    return 0;
}


