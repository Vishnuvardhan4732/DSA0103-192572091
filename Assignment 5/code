#include <iostream>

#include <vector>

#include <memory>

using namespace std;

 

class Bill {

public:

    virtual double calculateBill() = 0;

    virtual ~Bill() {}

};

 

class OutPatient : public Bill {

public:

    double calculateBill() override {

        return 1700;

    }

};

 

class InPatient : public Bill {

public:

    double calculateBill() override {

        return 47500;

    }

};

 

class DayCareBill : public Bill {

public:

    double calculateBill() override {

        return 18000;

    }

};

 

class EmergencyBill : public Bill {

public:

    double calculateBill() override {

        return 5000;

    }

};

 

int main() {

    vector<unique_ptr<Bill>> bills;

 

    bills.push_back(make_unique<OutPatient>());

    bills.push_back(make_unique<InPatient>());

    bills.push_back(make_unique<DayCareBill>());

    bills.push_back(make_unique<EmergencyBill>());

 

    double total = 0;

 

    for (const auto& bill : bills) {

        double amount = bill->calculateBill();

        cout << "Bill Amount: Rs. " << amount << endl;

        total += amount;

    }

 

    cout << "Grand Total: Rs. " << total << endl;

 

    return 0;

}

============================================B2 – Error Conditions and Claim Exceptions==========================================

#include <iostream>

#include <stdexcept>

using namespace std;

 

class ClaimException : public runtime_error {

public:

    ClaimException(string message) : runtime_error(message) {}

};

 

void processClaim(double amount, bool approved) {

    try {

        if (amount <= 0) {

            throw invalid_argument("Invalid claim amount");

        }

 

        if (!approved) {

            throw ClaimException("Insurance claim rejected");

        }

 

        cout << "Claim processed successfully" << endl;

    }

    catch (const ClaimException& e) {

        cout << "Claim Error: " << e.what() << endl;

        throw;

    }

}

 

int main() {

    try {

        processClaim(15000, false);

    }

    catch (const exception& e) {

        cout << "Main Error Handler: " << e.what() << endl;

    }

 

    return 0;

}

==================================B3 – Performance Comparison===============================================

#include <iostream>

#include <vector>

#include <chrono>

using namespace std;

using namespace chrono;

 

class Bill {

public:

    virtual double calculate() = 0;

    virtual ~Bill() {}

};

 

class OutPatient : public Bill {

public:

    double calculate() override {

        return 1700;

    }

};

 

class InPatient : public Bill {

public:

    double calculate() override {

        return 47500;

    }

};

 

int main() {

    const int N = 1000000;

 

    vector<Bill*> bills;

    OutPatient op;

    InPatient ip;

 

    for (int i = 0; i < N; i++) {

        if (i % 2 == 0)

            bills.push_back(&op);

        else

            bills.push_back(&ip);

    }

 

    auto start = high_resolution_clock::now();

 

    double total = 0;

 

    for (Bill* b : bills) {

        total += b->calculate();

    }

 

    auto stop = high_resolution_clock::now();

 

    auto duration = duration_cast<microseconds>(stop - start);

 

    cout << "Polymorphic Billing Total: Rs. " << total << endl;

    cout << "Execution Time: " << duration.count()

         << " microseconds" << endl;

 

    return 0;

}

