=========================================A1 – Polymorphic Bill Hierarchy===========================================

#include <iostream>

using namespace std;

 

class Bill {

public:

    virtual double calculateBill() = 0;

    virtual ~Bill() {}

};

 

class OutPatient : public Bill {

public:

    double calculateBill() override {

        return 500 + 1200;

    }

};

 

class InPatient : public Bill {

public:

    double calculateBill() override {

        return 25000 + 15000 + 7500;

    }

};

 

class DayCareBill : public Bill {

public:

    double calculateBill() override {

        return 12000 + 6000;

    }

};

 

class EmergencyBill : public Bill {

public:

    double calculateBill() override {

        return 5000;

    }

};

 

int main() {

    OutPatient op;

    InPatient ip;

    DayCareBill dc;

    EmergencyBill em;

 

    cout << "Out Patient Bill: " << op.calculateBill() << endl;

    cout << "In Patient Bill: " << ip.calculateBill() << endl;

    cout << "Day Care Bill: " << dc.calculateBill() << endl;

    cout << "Emergency Bill: " << em.calculateBill() << endl;

 

    return 0;

}

