public:

    void pay(double amount) override {

        cout << "Corporate payment: Rs. " << amount * 0.9 << endl;

    }

};

 

int main() {

    SelfPay s;

    Insurance i;

    CorporateTieUp c;

 

    s.pay(10000);

    i.pay(10000);

    c.pay(10000);

 

    return 0;

}

===============================A4 – Exception Handling Strategy=================================================

#include <iostream>

#include <stdexcept>

using namespace std;

 

class BillingError : public runtime_error {

public:

    BillingError(string message) : runtime_error(message) {}

};

 

class ClaimError : public BillingError {

public:

    ClaimError(string message) : BillingError(message) {}

};

 

class UnknownPackageError : public BillingError {

public:

    UnknownPackageError(string message) : BillingError(message) {}

};

 

void validateBill(double amount) {

    if (amount <= 0) {

        throw BillingError("Invalid billing amount");

    }

 

    cout << "Valid billing amount: Rs. " << amount << endl;

}

 

void validateClaim(bool approved) {

    if (!approved) {

        throw ClaimError("Insurance claim rejected");

    }

 

    cout << "Insurance claim approved" << endl;

}

 

void validatePackage(int packageCode) {

    if (packageCode < 1 || packageCode > 5) {

        throw UnknownPackageError("Unknown package selected");

    }

 

    cout << "Valid package selected" << endl;

}

 

int main() {

    try {

        validateBill(5000);

        validateClaim(false);

        validatePackage(2);

    }

    catch (const ClaimError& e) {

        cout << "Claim Error: " << e.what() << endl;

    }

    catch (const UnknownPackageError& e) {

        cout << "Package Error: " << e.what() << endl;

    }

    catch (const BillingError& e) {

        cout << "Billing Error: " << e.what() << endl;

    }

 

    return 0;

}

