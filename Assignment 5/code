class Payer {

public:

    virtual void pay(double amount) = 0;

    virtual ~Payer() {}

};

 

class SelfPay : public Payer {

public:

    void pay(double amount) override {

        cout << "Self payment: Rs. " << amount << endl;

    }

};

 

class Insurance : public Payer {

public:

    void pay(double amount) override {

        cout << "Insurance payment: Rs. " << amount * 0.8 << endl;

    }

};

 

