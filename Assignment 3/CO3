// ======================================================
// Q1. CONSTRUCTOR AND CONSTRUCTOR OVERLOADING
// ======================================================

#include <iostream>
#include <string>
#include <stdexcept>
using namespace std;

class Book {
    string title, author;
    int copies;

public:
    Book() : Book("Unknown", "Unknown", 0) {}

    explicit Book(string t) : Book(t, "Unknown", 1) {}

    Book(string t, string a, int c)
        : title(t), author(a), copies(c) {
        if (c < 0)
            throw invalid_argument("Copies cannot be negative");
    }

    void display() const {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Copies: " << copies << endl;
        cout << "----------------" << endl;
    }
};

int main() {
    try {
        Book b1;
        Book b2("C++ Programming");
        Book b3("Python", "James", 5);

        cout << "Default Book:" << endl;
        b1.display();

        cout << "Donated Book:" << endl;
        b2.display();

        cout << "Full Details Book:" << endl;
        b3.display();
    }
    catch (const invalid_argument &e) {
        cout << "Error: " << e.what() << endl;
    }

    return 0;
}


// ======================================================
// Q2. COPY CONSTRUCTOR - SHALLOW AND DEEP COPY
// ======================================================

#include <iostream>
#include <string>
#include <stdexcept>
using namespace std;

class Prescription {
    int n;
    string *medicines;

public:
    explicit Prescription(int count) : n(count), medicines(nullptr) {
        if (count < 0)
            throw invalid_argument("Invalid medicine count");

        medicines = new string[n];
    }

    Prescription(const Prescription &p)
        : n(p.n), medicines(new string[p.n]) {
        cout << "Copy constructor called" << endl;

        for (int i = 0; i < n; i++)
            medicines[i] = p.medicines[i];
    }

    Prescription& operator=(const Prescription &p) {
        if (this != &p) {
            string *temp = new string[p.n];

            for (int i = 0; i < p.n; i++)
                temp[i] = p.medicines[i];

            delete[] medicines;
            medicines = temp;
            n = p.n;
        }

        return *this;
    }

    ~Prescription() {
        delete[] medicines;
    }

    void set(int i, const string &m) {
        if (i >= 0 && i < n)
            medicines[i] = m;
    }

    string get(int i) const {
        if (i >= 0 && i < n)
            return medicines[i];

        return "";
    }
};

void displayByValue(Prescription p) {
    cout << "Passed by value" << endl;
}

void displayByReference(const Prescription &p) {
    cout << "Passed by reference" << endl;
}

int main() {
    Prescription p(2);

    p.set(0, "Paracetamol");
    p.set(1, "ORS");

    Prescription q = p;
    q.set(1, "Cetirizine");

    Prescription r(1);
    r = p;

    p.set(0, "Ibuprofen");

    cout << p.get(0) << " " << p.get(1) << " | ";
    cout << q.get(0) << " " << q.get(1) << " | ";
    cout << r.get(0) << " " << r.get(1) << endl;

    displayByValue(p);
    displayByReference(p);

    p = p;

    return 0;
}


// ======================================================
// Q3. DYNAMIC CONSTRUCTOR AND DESTRUCTOR
// ======================================================

#include <iostream>
#include <stdexcept>
using namespace std;

class Auditorium {
    int rows, seats;
    char **map;
    int booked;

public:
    Auditorium(int r, int s)
        : rows(r), seats(s), map(nullptr), booked(0) {

        if (rows < 0 || seats < 0)
            throw invalid_argument("Invalid seat dimensions");

        if (rows > 0 && seats > 0) {
            map = new char*[rows];

            for (int i = 0; i < rows; i++) {
                map[i] = new char[seats];

                for (int j = 0; j < seats; j++)
                    map[i][j] = 'O';
            }
        }

        cout << "Auditorium created" << endl;
    }

    void book(int r, int s) {
        if (r < 0 || r >= rows || s < 0 || s >= seats)
            cout << "Invalid seat" << endl;

        else if (map[r][s] == 'X')
            cout << "Seat already booked" << endl;

        else {
            map[r][s] = 'X';
            booked++;
            cout << "Seat booked" << endl;
        }
    }

    void cancel(int r, int s) {
        if (r >= 0 && r < rows &&
            s >= 0 && s < seats && map[r][s] == 'X') {

            map[r][s] = 'O';
            booked--;
            cout << "Booking cancelled" << endl;
        }
        else {
            cout << "Invalid cancellation" << endl;
        }
    }

    void display() const {
        cout << "Seat Map:" << endl;

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < seats; j++)
                cout << map[i][j] << " ";

            cout << endl;
        }
    }

    ~Auditorium() {
        for (int i = 0; i < rows; i++)
            delete[] map[i];

        delete[] map;

        cout << "Auditorium closed. Booked seats: "
             << booked << endl;
    }
};

int main() {
    Auditorium a1(2, 3);

    a1.book(0, 0);
    a1.book(1, 1);
    a1.cancel(0, 0);
    a1.display();

    {
        Auditorium a2(2, 2);
        a2.book(0, 1);
    }

    Auditorium *a3 = new Auditorium(3, 3);

    a3->book(1, 1);
    a3->display();

    delete a3;

    Auditorium a4(0, 3);

    return 0;
}


// ======================================================
// Q4. ARITHMETIC AND STREAM OPERATOR OVERLOADING
// ======================================================

#include <iostream>
#include <iomanip>
#include <cstdlib>
using namespace std;

class Money {
    long long paise;

public:
    Money(long long rupees = 0, int p = 0)
        : paise(rupees * 100 + p) {}

    Money operator+(const Money &m) const {
        Money result;
        result.paise = paise + m.paise;
        return result;
    }

    Money operator-(const Money &m) const {
        Money result;
        result.paise = paise - m.paise;
        return result;
    }

    Money& operator+=(const Money &m) {
        paise += m.paise;
        return *this;
    }

    bool operator==(const Money &m) const {
        return paise == m.paise;
    }

    bool operator<(const Money &m) const {
        return paise < m.paise;
    }

    friend ostream& operator<<(ostream &out, const Money &m) {
        long long amount = llabs(m.paise);

        if (m.paise < 0)
            out << "-";

        out << "Rs " << amount / 100 << "."
            << setfill('0') << setw(2) << amount % 100;

        return out;
    }

    friend istream& operator>>(istream &in, Money &m) {
        long long r;
        int p;

        in >> r >> p;

        if (in)
            m.paise = r * 100 + p;

        return in;
    }
};

int main() {
    Money a(120, 75), b(79, 25), c = a + b;

    cout << "Total: " << c << endl;

    cout << boolalpha;
    cout << (c == Money(200)) << endl;

    Money x(0, 75), y(0, 50);

    cout << "Paise Addition: " << x + y << endl;
    cout << "Subtraction: " << x - y << endl;

    a += b;

    cout << "After += : " << a << endl;
    cout << "Is x less than y? " << (x < y) << endl;

    return 0;
}


// ======================================================
// Q5. INCREMENT, COMPARISON AND SUBSCRIPT OPERATORS
// ======================================================

#include <iostream>
#include <string>
#include <stdexcept>
using namespace std;

class Time {
    int hours, minutes, seconds;

    void advance() {
        seconds++;

        if (seconds == 60) {
            seconds = 0;
            minutes++;
        }

        if (minutes == 60) {
            minutes = 0;
            hours++;
        }
    }

    int totalSeconds() const {
        return hours * 3600 + minutes * 60 + seconds;
    }

public:
    Time(int h = 0, int m = 0, int s = 0)
        : hours(h), minutes(m), seconds(s) {}

    Time& operator++() {
        advance();
        return *this;
    }

    Time operator++(int) {
        Time old = *this;
        advance();
        return old;
    }

    bool operator==(const Time &t) const {
        return totalSeconds() == t.totalSeconds();
    }

    bool operator<(const Time &t) const {
        return totalSeconds() < t.totalSeconds();
    }

    void display() const {
        cout << hours << ":" << minutes << ":" << seconds << endl;
    }
};

class Playlist {
    string tracks[3];

public:
    Playlist() {
        tracks[0] = "Song One";
        tracks[1] = "Song Two";
        tracks[2] = "Song Three";
    }

    string& operator[](int index) {
        if (index < 0 || index >= 3)
            throw out_of_range("Invalid track index");

        return tracks[index];
    }

    const string& operator[](int index) const {
        if (index < 0 || index >= 3)
            throw out_of_range("Invalid track index");

        return tracks[index];
    }
};

int main() {
    try {
        Time t(0, 59, 59);

        cout << "Original Time: ";
        t.display();

        Time a = t++;
        Time b = ++t;

        cout << "Postfix value: ";
        a.display();

        cout << "Prefix value: ";
        b.display();

        cout << "Current Time: ";
        t.display();

        Time t2(1, 0, 1);

        cout << boolalpha;
        cout << "Times equal: " << (t == t2) << endl;
        cout << "First time less: " << (a < t2) << endl;

        Playlist p;

        cout << "First Track: " << p[0] << endl;
        cout << "Second Track: " << p[1] << endl;

        p[1] = "New Song";

        cout << "Updated Track: " << p[1] << endl;
        cout << p[5] << endl;
    }
    catch (const out_of_range &e) {
        cout << "Error: " << e.what() << endl;
    }

    return 0;
}


// ======================================================
// Q6. DYNAMIC TEXT CLASS AND OPERATOR OVERLOADING
// ======================================================

#include <iostream>
#include <cstring>
using namespace std;

class Text {
    char *str;

public:
    Text(const char *s = "") {
        str = new char[strlen(s) + 1];
        strcpy(str, s);
    }

    Text(const Text &t) {
        str = new char[strlen(t.str) + 1];
        strcpy(str, t.str);
    }

    Text& operator=(const Text &t) {
        if (this != &t) {
            char *temp = new char[strlen(t.str) + 1];
            strcpy(temp, t.str);

            delete[] str;
            str = temp;
        }

        return *this;
    }

    Text operator+(const Text &t) const {
        char *temp = new char[strlen(str) + strlen(t.str) + 1];

        strcpy(temp, str);
        strcat(temp, t.str);

        Text result(temp);

        delete[] temp;

        return result;
    }

    bool operator==(const Text &t) const {
        return strcmp(str, t.str) == 0;
    }

    bool operator!=(const Text &t) const {
        return !(*this == t);
    }

    friend ostream& operator<<(ostream &out, const Text &t) {
        out << t.str;
        return out;
    }

    ~Text() {
        delete[] str;
    }
};

int main() {
    Text a("Hello "), b("World"), c("!");
    Text result = a + b + c;

    cout << "First Text: " << a << endl;
    cout << "Second Text: " << b << endl;
    cout << "Combined Text: " << result << endl;

    Text d = a;

    cout << "Copied Text: " << d << endl;

    cout << boolalpha;
    cout << "Equal: " << (a == d) << endl;
    cout << "Not Equal: " << (a != b) << endl;

    a = a;

    cout << "After Self Assignment: " << a << endl;

    Text empty("");

    cout << "Empty Text: [" << empty << "]" << endl;

    return 0;
}


// ======================================================
// Q7. COMPLEX NUMBER AND AC CIRCUIT IMPEDANCE
// ======================================================

#include <iostream>
#include <cmath>
#include <stdexcept>
using namespace std;

class Complex {
    double real, imag;

public:
    Complex() : real(0), imag(0) {}

    Complex(double r) : real(r), imag(0) {}

    Complex(double r, double i) : real(r), imag(i) {}

    Complex operator+(const Complex &c) const {
        return Complex(real + c.real, imag + c.imag);
    }

    Complex operator-(const Complex &c) const {
        return Complex(real - c.real, imag - c.imag);
    }

    Complex operator*(const Complex &c) const {
        return Complex(
            real * c.real - imag * c.imag,
            real * c.imag + imag * c.real
        );
    }

    Complex operator/(const Complex &c) const {
        double denominator = c.real * c.real + c.imag * c.imag;

        if (denominator == 0)
            throw runtime_error("Division by zero impedance");

        return Complex(
            (real * c.real + imag * c.imag) / denominator,
            (imag * c.real - real * c.imag) / denominator
        );
    }

    bool operator==(const Complex &c) const {
        return real == c.real && imag == c.imag;
    }

    double magnitude() const {
        return sqrt(real * real + imag * imag);
    }

    friend ostream& operator<<(ostream &out, const Complex &c) {
        out << c.real;

        if (c.imag >= 0)
            out << " + j" << c.imag;
        else
            out << " - j" << -c.imag;

        return out;
    }
};

int main() {
    try {
        Complex Z1(10, 5), Z2(0, -2);

        Complex series = Z1 + Z2;
        Complex parallel = (Z1 * Z2) / series;

        cout << "Z1: " << Z1 << endl;
        cout << "Z2: " << Z2 << endl;

        cout << "Series Impedance: " << series << endl;
        cout << "Series Magnitude: " << series.magnitude() << endl;

        cout << "Parallel Impedance: " << parallel << endl;
        cout << "Parallel Magnitude: " << parallel.magnitude() << endl;

        Complex z3(10, 5);

        cout << boolalpha;
        cout << "Z1 equals Z3: " << (Z1 == z3) << endl;

        Complex zero(0, 0);
        Complex result = Z1 / zero;

        cout << result << endl;
    }
    catch (const runtime_error &e) {
        cout << "Error: " << e.what() << endl;
    }

    return 0;
}
